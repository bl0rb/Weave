{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weave",
  "mainBinaryName": "Weave",
  "version": "0.1.7",
  "identifier": "io.github.bl0rb.weave.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Weave",
        "width": 480,
        "height": 720,
        "minWidth": 380,
        "minHeight": 460,
        "center": true,
        "visible": false
      },
      {
        "label": "quick",
        "url": "quick.html",
        "title": "Weave",
        "width": 780,
        "height": 66,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "© 2026 bl0rb · MIT + Commons Clause · github.com/bl0rb/Weave",
    "shortDescription": "Ask Weave from the menu bar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["weave"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMkMwNUI4OTA2NTQ0Q0EKUldUS1JHV1F1QVVzVEkxTFJ3ZXFURVVXbnBWSVBxb1pvSzJhSUJFUDNZeWFMRlJPZ2c5c28zblkK",
      "endpoints": [
        "https://github.com/bl0rb/Weave/releases/download/desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
