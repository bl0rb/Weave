# NUR fuer den Einzelbetrieb dieses Dienstes ausserhalb des Compose-Stacks.
# Im Stack wird nichts hiervon benutzt: dort kommt jeder Wert aus weave.yaml
# im Repo-Wurzelverzeichnis, und `python scripts/weave_config.py render`
# schreibt deploy/.env -- die Datei wird nie von Hand bearbeitet.
#
# Beispielkonfiguration fuer den Weave-Reranker. Kopieren nach `.env` und
# mit echten Werten fuellen. `.env` selbst ist in .gitignore und darf nie
# eingecheckt werden.

# --- Modell -----------------------------------------------------------
# Vorgegeben, nicht aendern ohne Ruecksprache -- siehe README "Warum nicht
# fastembed" fuer die Begruendung, warum dieses Modell ueber
# sentence-transformers laeuft statt ueber fastembed.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Wo die ~2.3 GB Modellgewichte gecacht werden. Im Docker-Image auf ein
# Volume gemountet (siehe Dockerfile) -- lokal reicht der Default.
RERANKER_CACHE_DIR=./.cache

# --- Auth (PFLICHT) -----------------------------------------------------
# Fail-closed wie bei jedem anderen Weave-Service-Token (Weave-Retrievals
# RETRIEVAL_API_TOKEN, Weave-Tools' TOOLS_API_TOKEN, ...): leer gelassen
# antwortet POST /rerank auf JEDEN Request mit 503, statt irgendeinen (oder
# gar keinen) Authorization-Header als gueltig durchzulassen. GET /health
# ist bewusst ausgenommen -- ein Liveness-Check hat kein Bearer-Token dabei.
RERANKER_API_TOKEN=

# --- CPU-Tuning ---------------------------------------------------------
# An CrossEncoder.predict(batch_size=...) durchgereicht.
RERANKER_BATCH_SIZE=16
# An torch.set_num_threads(...) durchgereicht. Bewusst deutlich unter der
# vollen Kernzahl der Maschine -- siehe README "Betriebsempfehlung".
RERANKER_THREADS=4

# --- Der wichtigste Schutz: ein Cross-Encoder rechnet PRO DOKUMENT -------
# Siehe README's gemessene Laufzeiten fuer die Empfehlung, wie dieser Wert
# zu eurem Retrieval-top_k passt.
RERANKER_MAX_DOCUMENTS=50
