# Beispielkonfiguration fuer Weave-Knowledge. Kopieren nach `.env` (im
# Repo-Root oder unter backend/, je nachdem von wo der Prozess gestartet
# wird -- pydantic-settings' `env_file='.env'` ist relativ zum Arbeits-
# verzeichnis) und mit echten Werten fuellen. `.env` selbst ist in
# .gitignore und darf nie eingecheckt werden.

# --- Datenbank ---
# Default ist eine lokale SQLite-Datei (Zero-Setup fuer Dev/Tests, siehe
# backend/app/core/config.py). Eine echte Bereitstellung setzt hier eine
# postgresql+psycopg://-URL mit installierter pgvector-Extension -- siehe
# ADR-0004: dieser Service besitzt seine eigene Datenbank `weave_knowledge`,
# niemals eine gemeinsam genutzte.
DATABASE_URL=sqlite:///./weave_knowledge.db

# --- Redis / Celery ---
# Logical-DB 1, nicht 0 -- gemaess ADR-0001 bekommt jeder Weave-Service eine
# eigene Redis-Logical-DB auf derselben gemeinsam genutzten Redis-Instanz,
# damit Broker-/Result-Backend-Traffic zwischen den Services nie kollidiert
# (Weave-Ingest nutzt DB 0).
REDIS_URL=redis://localhost:6379/1

# Signiert/verschluesselt alles, was dieser Service persistiert. Gemaess
# ADR-0003 hat jeder Service seinen eigenen SECRET_KEY -- niemals mit einem
# anderen Weave-Service geteilt.
SECRET_KEY=dev-only-insecure-secret-key-do-not-use-in-production

# --- Weave-Ingest-Anbindung ---
# Wird benutzt, um nach einem document.processed-Event die markdown_url des
# Jobs abzurufen (siehe contracts/events/document.processed.md). Die
# Download-Route verlangt dieselbe Authentifizierung wie jeder andere
# Weave-Ingest-API-Aufruf -- WEAVE_INGEST_API_TOKEN muss also ein echtes,
# fuer diesen Service angelegtes Weave-Ingest-API-Token sein
# (Authorization: Bearer pd_...), nicht nur die Basis-URL.
WEAVE_INGEST_BASE_URL=http://localhost:8000
WEAVE_INGEST_API_TOKEN=

# HMAC-SHA256-Secret zur Verifikation des X-Weave-Ingest-Signature-Headers
# auf eingehenden document.processed-Webhooks (siehe
# contracts/events/document.processed.md, Abschnitt "Signaturverfahren").
# Muss mit dem auf der Weave-Ingest-Webhook-Verbindung konfigurierten Secret
# uebereinstimmen. Leer = Signaturpruefung deaktiviert (nur fuer lokale Dev).
WEAVE_INGEST_WEBHOOK_SECRET=

# --- Embedding-Provider ---
# 'fake' ist ein deterministischer, abhaengigkeitsfreier Provider fuer
# lokale Entwicklung und die Testsuite -- kein echter API-Key noetig.
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=fake-embed
# Muss mit der pgvector-Spaltenbreite aus
# backend/alembic/versions/0001_init.py uebereinstimmen. Eine Aenderung
# erfordert eine neue Migration (neue vector(N)-Spalte) plus einen
# vollstaendigen Reindex aller bestehenden Chunks, kein reiner Env-Var-Flip.
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64

# --- Strukturbewusstes Chunking ---
CHUNK_MAX_CHARS=3000
CHUNK_OVERLAP_CHARS=200

# --- DB-Connection-Pool (nur relevant fuer Postgres, siehe
# backend/app/core/db.py -- SQLite ignoriert diese Werte) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=3600
DB_POOL_TIMEOUT_SECONDS=10
