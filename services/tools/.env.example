# NUR fuer den Einzelbetrieb dieses Dienstes ausserhalb des Compose-Stacks.
# Im Stack wird nichts hiervon benutzt: dort kommt jeder Wert aus weave.yaml
# im Repo-Wurzelverzeichnis, und `python scripts/weave_config.py render`
# schreibt deploy/.env -- die Datei wird nie von Hand bearbeitet.
#
# Beispielkonfiguration fuer Weave-Tools. Kopieren nach `.env` (im
# Repo-Root oder unter backend/, je nachdem von wo der Prozess gestartet
# wird -- pydantic-settings' `env_file='.env'` ist relativ zum
# Arbeitsverzeichnis) und mit echten Werten fuellen. `.env` selbst ist in
# .gitignore und darf nie eingecheckt werden.

# --- Eingehende Service-Auth fuer die REST-Seite (backend/app/api/tools.py) ---
# Gilt NUR fuer die REST-Endpunkte (POST/GET /api/v1/tools/*), NICHT fuer den
# MCP-Server -- und ist ein voellig anderes Credential als der
# Authorization-Header, den ein Aufrufer auf BEIDEN Oberflaechen mitschickt
# (siehe unten "Zwei Token-Arten"). Wird auf einem eigenen Header geprueft
# (X-Tools-Service-Token), damit sich beide Credentials nie in die Quere
# kommen. Leer gelassen antworten die REST-Routen auf JEDEN Request mit 503
# statt den Endpunkt versehentlich offen zu lassen -- eine echte
# Bereitstellung MUSS diesen Wert setzen.
TOOLS_API_TOKEN=

# --- Personal-Token-Pfad der Rechte-Aufloesung (backend/app/services/scope.py) ---
# Weave-Tools ist hier der AUFRUFER: INTROSPECTION_SERVICE_TOKEN ist das
# Credential, das DIESER Service bei Weave-API's
# POST /internal/tokens/introspect vorzeigt, um einen rohen Personal-Token
# auf seine Identitaet aufzuloesen -- muss mit dem Wert uebereinstimmen, den
# Weave-API selbst fuer diesen Zweck konfiguriert hat.
WEAVE_API_BASE_URL=http://localhost:8004
INTROSPECTION_SERVICE_TOKEN=
WEAVE_API_TIMEOUT_SECONDS=10

# --- Aufrufe an Weave-Retrieval (backend/app/services/tools.py) ---
# Sowohl fuer list_collections (GET .../api/v1/collections) als auch fuer
# search (POST .../api/v1/search). RETRIEVAL_API_TOKEN ist das statische
# Bearer-Token, das Weave-Retrievals eigenes require_service_token erwartet
# -- ein weiteres, von den beiden oben komplett unabhaengiges Credential.
RETRIEVAL_BASE_URL=http://localhost:8002
RETRIEVAL_API_TOKEN=
RETRIEVAL_TIMEOUT_SECONDS=10

# --- Delegations-Token (siehe README "Zwei Token-Arten" und
# backend/app/services/scope.py fuer das vollstaendige Format) ---
# PFLICHT, nicht optional -- ein SYMMETRISCHES Secret: Weave-Runtime
# signiert damit, wenn es einem externen Agenten (n8n, einem MCP-Client)
# fuer kurze Zeit genau die Leserechte des gerade fragenden Menschen
# ausleiht; Weave-Tools prueft mit demselben Wert. Muss in Weave-Runtime UND
# Weave-Tools IDENTISCH gesetzt sein -- ein Tippfehler, ein vergessener
# Eintrag oder Drift zwischen den beiden Deployments ist hier kein
# harmloser Fehlerfall, sondern ein Sicherheitsproblem: Leer gelassen
# antwortet JEDE Delegations-Token-Pruefung mit 503 (Dienst
# fehlkonfiguriert), statt ein leeres Secret jemals gegen eine ebenso
# leere, von einem Angreifer selbst berechnete Signatur matchen zu lassen
# (siehe backend/app/services/scope.py:_verify_delegation_token).
WEAVE_DELEGATION_SECRET=
# Gueltigkeitsdauer eines frisch ausgestellten Delegations-Tokens in
# Sekunden -- bewusst kurz: die Ausleihe muss nie laenger leben als der
# einzelne Chat-Turn/Tool-Aufruf, fuer den sie ausgestellt wurde.
DELEGATION_TOKEN_TTL_SECONDS=300
