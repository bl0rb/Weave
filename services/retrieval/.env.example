# NUR fuer den Einzelbetrieb dieses Dienstes ausserhalb des Compose-Stacks.
# Im Stack wird nichts hiervon benutzt: dort kommt jeder Wert aus weave.yaml
# im Repo-Wurzelverzeichnis, und `python scripts/weave_config.py render`
# schreibt deploy/.env -- die Datei wird nie von Hand bearbeitet.
#
# Beispielkonfiguration fuer Weave-Retrieval. Kopieren nach `.env` (im
# Repo-Root oder unter backend/, je nachdem von wo der Prozess gestartet
# wird -- pydantic-settings' `env_file='.env'` ist relativ zum Arbeits-
# verzeichnis) und mit echten Werten fuellen. `.env` selbst ist in
# .gitignore und darf nie eingecheckt werden.

# --- Datenbank ---
# Weave-Retrieval besitzt KEIN eigenes Schema: `documents`/`chunks` sind ein
# geteiltes Read-Model, dessen einziger Schreiber Weave-Knowledge ist (siehe
# contracts/chunk-store.md). Eine echte Bereitstellung zeigt
# DATABASE_URL deshalb auf DIESELBE `weave_knowledge`-Postgres-Datenbank,
# aber ueber eine eigene, rein lesende DB-Rolle (nur SELECT-Grants, siehe
# den Vertrag fuer das genaue GRANT-Statement) -- niemals ueber
# Weave-Knowledges eigene Schreib-Credentials und niemals mit eigenem
# Alembic. Default ist eine lokale SQLite-Datei (Zero-Setup fuer Dev/Tests).
DATABASE_URL=sqlite:///./weave_retrieval.db

# --- Service-Auth ---
# Bearer-Token, das jeder Service-Aufrufer (aktuell Weave-Runtime) im
# `Authorization: Bearer <...>`-Header mitschicken muss (ADR-0002s
# "Bearer-Token (wie in PaddleDoc)"-Muster fuer Maschinen-Aufrufer). Leer
# gelassen antwortet der Service auf JEDEN authentifizierten Request mit
# 503 (Fehlkonfiguration) statt den Endpunkt versehentlich offen zu lassen
# -- eine echte Bereitstellung MUSS diesen Wert setzen.
RETRIEVAL_API_TOKEN=

# --- Embedding-Provider ---
# MUSS zum Modell/zur Dimension passen, mit der Weave-Knowledge die
# chunks.embedding-Spalte tatsaechlich befuellt hat -- eine Suchanfrage, die
# mit einem anderen Modell/einer anderen Dimension eingebettet wird, ist
# nicht nur ungenauer, sondern bedeutungslos (Cosine-Distanz zwischen
# inkompatiblen Embedding-Raeumen). Gleiche Defaults wie Weave-Knowledge aus
# genau diesem Grund. 'fake' ist ein deterministischer, abhaengigkeitsfreier
# Provider fuer lokale Entwicklung und die Testsuite -- kein echter
# API-Key noetig.
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=fake-embed
# Muss mit der pgvector-Spaltenbreite uebereinstimmen, die Weave-Knowledge
# fuer `chunks.embedding` tatsaechlich angelegt hat (siehe dessen
# alembic/versions/0001_init.py).
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64

# --- Reranker ---
# 'none' ueberspringt Reranking komplett -- RRF-fusionierte Ergebnisse
# werden unveraendert auf final_k gekuerzt zurueckgegeben. Eine echte
# Bereitstellung kann hier einen gehosteten Reranker (Cohere, jina.ai, ...)
# oder einen selbstgehosteten eintragen.
RERANK_PROVIDER=none
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# --- Hybrid-Search-Pipeline ---
# search_top_k: Kandidaten je Suchpfad (Vektor UND Volltext) vor der Fusion.
# search_final_k: Ergebnisse nach RRF-Fusion (und optionalem Reranking).
# rrf_k: Glaettungskonstante der Reciprocal-Rank-Fusion (1 / (rrf_k + rang)) --
# 60 ist der in der Originalarbeit verwendete und ueblicherweise
# uebernommene Wert.
SEARCH_TOP_K=20
SEARCH_FINAL_K=5
RRF_K=60

# --- DB-Connection-Pool (nur relevant fuer Postgres, siehe
# backend/app/core/db.py -- SQLite ignoriert diese Werte) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=3600
DB_POOL_TIMEOUT_SECONDS=10
