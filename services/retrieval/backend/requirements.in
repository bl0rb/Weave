# Direct dependencies of the backend image (see Dockerfile) and of the
# local development environment. Hash-Lock folgt spaeter -- requirements.txt
# is currently a plain `pip freeze` of the resolved tree, not a
# `pip-compile --generate-hashes` lock (see requirements.txt's own header).
#
# Version pins shared with Weave-Knowledge (fastapi/sqlalchemy/pydantic/
# pydantic-settings/psycopg/pgvector/pytest/httpx/PyYAML/uvicorn) are kept
# identical to that service's backend/requirements.in -- Weave-Retrieval
# reads the very same weave_knowledge database rows (see
# contracts/chunk-store.md), so drift between the two
# services' SQLAlchemy/pgvector/psycopg versions could silently change how a
# `vector` column round-trips. No celery/redis/alembic here: this service
# has no worker queue (search is synchronous, see README) and owns no
# schema of its own to migrate (it is the read-only side of the shared
# chunk-store contract, never the writer).
fastapi==0.162.0
uvicorn[standard]==0.54.0
pydantic==2.14.2
pydantic-settings==2.16.2
sqlalchemy==2.1.8
psycopg[binary]==3.3.8
pgvector==0.5.1
pytest==9.2.0
httpx==0.28.1
PyYAML==6.0.3
