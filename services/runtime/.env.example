# Beispielkonfiguration fuer Weave-Runtime. Kopieren nach `.env` (im
# Repo-Root oder unter backend/, je nachdem von wo der Prozess gestartet
# wird -- pydantic-settings' `env_file='.env'` ist relativ zum
# Arbeitsverzeichnis) und mit echten Werten fuellen. `.env` selbst ist in
# .gitignore und darf nie eingecheckt werden.

# --- Eingehender Service-Auth ---
# Bearer-Token, das jeder Aufrufer DIESES Service (aktuell Weave-API's
# Gateway) im `Authorization: Bearer <...>`-Header mitschicken muss
# (ADR-0002s "Bearer-Token (wie in PaddleDoc)"-Muster fuer
# Maschinen-Aufrufer, siehe backend/app/core/auth.py). Leer gelassen
# antwortet der Service auf JEDEN authentifizierten Request mit 503
# (Fehlkonfiguration) statt den Endpunkt versehentlich offen zu lassen --
# eine echte Bereitstellung MUSS diesen Wert setzen.
RUNTIME_API_TOKEN=

# --- Ausgehender Aufruf an Weave-Retrieval ---
# Weave-Runtime ist hier der AUFRUFER: RETRIEVAL_API_TOKEN ist das Token,
# das DIESER Service bei Weave-Retrieval vorzeigt -- ein voellig anderes
# Credential als RUNTIME_API_TOKEN oben (das authentifiziert Aufrufer DIESES
# Service; dieses authentifiziert diesen Service als Aufrufer eines
# anderen). Muss mit dem RETRIEVAL_API_TOKEN uebereinstimmen, das
# Weave-Retrieval selbst konfiguriert hat.
RETRIEVAL_BASE_URL=http://localhost:8002
RETRIEVAL_API_TOKEN=
RETRIEVAL_TIMEOUT_SECONDS=10

# --- LLM-Provider ---
# 'fake' ist ein deterministischer, abhaengigkeitsfreier Provider fuer
# lokale Entwicklung und die Testsuite -- kein echter API-Key noetig, kein
# ausgehender Netzwerkzugriff. Eine echte Bereitstellung traegt hier den
# tatsaechlichen Provider (z.B. 'openai', 'anthropic', ein lokal gehostetes
# Modell) samt Base-URL/API-Key/Default-Modell ein.
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=
LLM_TIMEOUT_SECONDS=60

# --- Intent-Router ---
# 'rules': deterministischer, abhaengigkeitsfreier Keyword-/Heuristik-Router.
# 'llm': delegiert die Klassifizierung selbst an LLM_PROVIDER.
ROUTER_MODE=rules

# --- Delegations-Token (siehe backend/app/services/delegation.py,
# contracts/n8n-flow.md) ---
# Muss identisch mit Weave-Tools' eigenem WEAVE_DELEGATION_SECRET sein (dort
# der Pruefer dieses Tokens). Leer gelassen schlaegt das Ausstellen eines
# Tokens hart fehl -- kein unsigniertes Token, kein Fallback.
WEAVE_DELEGATION_SECRET=
DELEGATION_TOKEN_TTL_SECONDS=300

# --- n8n-Bot-Provider (siehe backend/app/services/n8n_client.py,
# bots/n8n-agent.yaml.example, contracts/n8n-flow.md) ---
# JSON-Liste erlaubter Basis-URLs; ein n8n-Bot laedt nur, wenn sein
# webhook_url mit einer davon beginnt (SSRF-Schutz, geprueft beim Laden der
# Bot-YAML, nicht erst beim Aufruf). Leer (Default) == n8n-Bots sind
# deaktiviert.
N8N_ALLOWED_BASE_URLS=[]
# Wird n8n unveraendert als `tools_base_url` mitgeschickt, damit der Flow
# weiss, wo Weave-Tools (MCP oder REST) erreichbar ist.
TOOLS_BASE_URL=

# --- Bot-Konfigurationsverzeichnis ---
# Wird bei JEDEM Aufruf frisch von der Platte gelesen (siehe
# backend/app/services/botconfig.py) -- kein In-Process-Cache, das
# invalidiert werden muesste, wenn ein Operator eine Bot-Datei bearbeitet.
# Relativ zum Arbeitsverzeichnis des Prozesses: sowohl lokale Entwicklung
# (README, "Entwicklung" -- gestartet vom Repo-Root aus) als auch das
# Dockerfile (WORKDIR /app, `bots/` liegt dort neben `app/`) haben `bots/`
# als direktes Kind des Arbeitsverzeichnisses, daher passt dieser Default
# unveraendert in beiden Faellen.
BOTS_DIR=./bots
