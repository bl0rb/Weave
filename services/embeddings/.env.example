# NUR fuer den Einzelbetrieb dieses Dienstes ausserhalb des Compose-Stacks.
# Im Stack wird nichts hiervon benutzt: dort kommt jeder Wert aus weave.yaml
# im Repo-Wurzelverzeichnis, und `python scripts/weave_config.py render`
# schreibt deploy/.env -- die Datei wird nie von Hand bearbeitet.
#
# Beispielkonfiguration fuer den Weave-Embeddings-Dienst. Kopieren nach
# `.env` (im Arbeitsverzeichnis des Prozesses -- pydantic-settings'
# `env_file='.env'` ist relativ dazu) und mit echten Werten fuellen. `.env`
# selbst ist in .gitignore und darf nie eingecheckt werden.

# --- Modell -----------------------------------------------------------
# Vom Nutzer vorgegebenes Modell (siehe README "Modellwahl"). Default ist
# bereits intfloat/multilingual-e5-small -- diese Variable muss nur
# gesetzt werden, um testweise ein anderes Modell aus derselben Familie
# (z.B. intfloat/multilingual-e5-base oder -large) zu laden. Ein Modell
# einer strukturell anderen Architektur braucht Code-Aenderungen in
# app/services/encoder.py, nicht nur diese Variable -- siehe deren
# Docstring.
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- Eingehender Service-Auth -------------------------------------------
# Bearer-Token, das jeder Aufrufer im `Authorization: Bearer <...>`-Header
# mitschicken muss -- exakt so, wie jeder OpenAI-Client seinen eigenen
# API-Key ohnehin schon sendet (siehe Weave-Knowledges
# OpenAICompatibleProvider). Leer gelassen antwortet der Dienst auf JEDEN
# Aufruf von /v1/embeddings und /v1/models mit 503 (Fehlkonfiguration)
# statt den Endpunkt versehentlich offen zu lassen -- eine echte
# Bereitstellung MUSS diesen Wert setzen. /health ist absichtlich NICHT
# durch dieses Token geschuetzt (siehe app/main.py).
EMBEDDINGS_API_TOKEN=

# --- Laufzeit-Tuning ------------------------------------------------------
# Interne Batch-Groesse pro onnxruntime-Forward-Pass. Ein Request mit mehr
# Eintraegen als das wird intern in mehrere Batches dieser Groesse
# aufgeteilt -- die Reihenfolge in der Antwort (per `index`) bleibt davon
# unberuehrt.
EMBEDDINGS_BATCH_SIZE=32

# Anzahl onnxruntime-Intra-Op-Threads. 0 = automatisch (os.cpu_count() zur
# Ladezeit aufgeloest -- der aufgeloeste Wert steht danach in GET /health).
EMBEDDINGS_THREADS=0

# Wohin huggingface_hub heruntergeladene Modelldateien cacht. Leer laesst
# huggingface_hub seinen eigenen Default nehmen (~/.cache/huggingface, im
# Docker-Image das Home-Verzeichnis des weave-embeddings-Nutzers). Das
# mitgelieferte Dockerfile setzt hierfuer standardmaessig /models und
# deklariert das als VOLUME -- eine echte Bereitstellung sollte dort (oder
# unter einem hier ueberschriebenen Pfad) ein Volume moutieren, damit der
# ~470MB-ONNX-Download eine Container-Neuerstellung uebersteht.
EMBEDDINGS_CACHE_DIR=

# Obergrenze, wie viele Texte ein einzelner /v1/embeddings-Request in
# seiner `input`-Liste tragen darf (ein einzelner String-Input zaehlt
# immer als genau 1 und ist von dieser Grenze nie betroffen). Ueberschreiten
# antwortet mit 413, nicht 400 -- das ist eine Groessenbegrenzung des
# Requests, kein fehlerhaft geformter Request.
EMBEDDINGS_MAX_INPUTS=256

# Ob zurueckgegebene Vektoren L2-normalisiert werden (Norm 1). Empfehlung
# des multilingual-e5-Modellkartentexts fuer Cosine-Similarity/Dot-Product;
# pgvectors `<=>`-Operator (was Weave-Retrievals Suche tatsaechlich nutzt)
# ist skaleninvariant und funktioniert auch ohne, aber normalisierte
# Vektoren machen auch ein einfaches Dot-Product aequivalent zu Cosine
# Similarity -- die sicherere Voreinstellung fuer jeden Verbraucher, der
# nicht spezifisch `<=>` nutzt.
EMBEDDINGS_NORMALIZE=true

# --- Nebenlaeufigkeitsgrenze (OOM-Vorfall 2026-09-22) ---------------------
# Wie viele /v1/embeddings-Requests gleichzeitig encoder.encode() ausfuehren
# duerfen. Davor gab es fuer run_in_threadpool keine eigene Grenze (Starlettes
# Default-Pool hat 40 Threads) -- ein Schub gleichzeitiger Aufrufer (z.B. ein
# Knowledge-Celery-Worker, der viele Release-Batches parallel abfeuert)
# konnte diesen Pod (CPU-Limit 2, Memory-Limit 2560Mi) OOM-killen. Default 1
# serialisiert Encodes vollstaendig -- siehe app/main.py's `_encode_semaphore`.
EMBEDDINGS_MAX_CONCURRENT_REQUESTS=1

# Wie lange ein Request auf einen freien Nebenlaeufigkeits-Slot wartet, bevor
# dieser Dienst aufgibt und mit 503 (samt Retry-After) statt einem Stau hinter
# einem bereits ausgelasteten Encoder antwortet -- siehe app/main.py's
# create_embeddings. Muss unter Knowledges EMBEDDING_REQUEST_TIMEOUT_SECONDS
# (Client-Read-Timeout) bleiben.
EMBEDDINGS_QUEUE_TIMEOUT_SECONDS=90
