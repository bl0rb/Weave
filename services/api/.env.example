# Beispielkonfiguration fuer Weave-API. Kopieren nach `.env` (im Repo-Root
# oder unter backend/, je nachdem von wo der Prozess gestartet wird --
# pydantic-settings' `env_file='.env'` ist relativ zum Arbeitsverzeichnis)
# und mit echten Werten fuellen. `.env` selbst ist in .gitignore und darf
# nie eingecheckt werden.

# --- Datenbank ---
# Weave-API besitzt sein eigenes Schema (`users`, `api_tokens`,
# `conversations`, `messages`) in einer eigenen `weave_api`-Datenbank
# (ADR-0004: ein Postgres-Cluster, aber eine Database pro Service, keine
# geteilten Tabellen). Default ist eine lokale SQLite-Datei (Zero-Setup fuer
# Dev/Tests) -- eine echte Bereitstellung setzt dies auf eine
# postgresql+psycopg://-URL.
DATABASE_URL=sqlite:///./weave_api.db

# Signiert/verschluesselt, was dieser Service persistiert. Jeder Service
# haelt gemaess ADR-0003 seinen eigenen SECRET_KEY -- niemals zwischen
# Services teilen, auch wenn dieses Skeleton-Stadium noch nichts damit
# verschluesselt (reserviert fuer eine spaetere OIDC/Session-Schicht an
# diesem Gateway, siehe ADR-0002).
SECRET_KEY=dev-only-insecure-secret-key-do-not-use-in-production

# --- Weave-Runtime (app/services/runtime_client.py) ---
# Weave-API ist ein vertrauenswuerdiger interner Aufrufer von Weave-Runtimes
# `/internal/bots`-Oberflaeche (GET /v1/bots, GET /v1/bots/{id} proxyen
# direkt durch) -- ein einzelnes geteiltes Service-Token, dasselbe
# Service-zu-Service-Muster wie bei Weave-Retrieval (ADR-0002).
RUNTIME_BASE_URL=http://localhost:8003
RUNTIME_API_TOKEN=

# --- Weave-Retrieval (app/services/retrieval_client.py) ---
# Fuer GET /v1/collections: Weave-API fragt Weave-Retrievals eigene
# Collections-Lese-Autoritaet (GET /api/v1/collections) nach den
# Collections, die das Team des aufrufenden Nutzers lesen darf. Dasselbe
# Service-zu-Service-Muster wie oben bei Weave-Runtime, nur gegen einen
# anderen Backend-Service und dessen eigenes RETRIEVAL_API_TOKEN.
RETRIEVAL_BASE_URL=http://localhost:8002
RETRIEVAL_API_TOKEN=

# --- Token-Introspection (app/api/internal.py) ---
# Schuetzt POST /internal/tokens/introspect -- ein voellig ANDERES Geheimnis
# als RUNTIME_API_TOKEN/RETRIEVAL_API_TOKEN oben (jene authentifizieren
# Weave-API als Aufrufer BEI einem anderen Service, dieses hier
# authentifiziert einen anderen Service, der HIER anfragt). Wie ein
# Master-Key behandeln: wer ihn kennt, kann die Identitaet hinter JEDEM
# Personal-API-Token in dieser Datenbank aufloesen. Leer = Endpunkt
# antwortet hart mit 503, niemals unauthentifiziert offen.
INTROSPECTION_SERVICE_TOKEN=

# --- Rate-Limiting (app/core/ratelimit.py) ---
# Feste-Fenster-Begrenzung pro authentifiziertem Nutzer und rollierender
# Minute. In-Process/Single-Instance -- siehe das Modul-Docstring fuer eine
# Redis-basierte Variante bei mehreren Replicas.
RATE_LIMIT_PER_MINUTE=30

# --- Chat-Verlauf ---
# Begrenzt, wie viele der juengsten Nachrichten einer Konversation bei
# einem weiteren Chat-Turn an Weave-Runtime als Kontext mitgeschickt werden
# (sobald POST /v1/chat implementiert ist, siehe README-Status).
HISTORY_MAX_MESSAGES=20

# --- DB-Connection-Pool (nur relevant fuer Postgres, siehe
# backend/app/core/db.py -- SQLite ignoriert diese Werte) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=3600
DB_POOL_TIMEOUT_SECONDS=10

# --- HTTP-Timeouts fuer ausgehende Aufrufe an Weave-Runtime ---
HTTP_CONNECT_TIMEOUT_SECONDS=5.0
HTTP_READ_TIMEOUT_SECONDS=10.0

# --- POST /v1/chat Request-Body ---
# Maximale Laenge einer einzelnen Chat-Nachricht (app/schemas/chat.py).
CHAT_MESSAGE_MAX_LENGTH=8000

# --- OIDC-Browser-Session-Login (app/api/auth.py, app/services/oidc.py,
# ADR-0002) ---
# Zusaetzlich zum Personal-API-Token (siehe CLI im README) -- ein Mensch im
# Browser kann sich hierueber anmelden und bekommt ein Session-Cookie statt
# eines Bearer-Tokens. Aktiviert ist OIDC genau dann, wenn OIDC_ISSUER UND
# OIDC_CLIENT_ID beide gesetzt sind -- sonst antworten die
# /v1/auth/oidc/*- und /v1/auth/logout-Endpunkte mit 404, als gaebe es sie
# nicht, und das Personal-API-Token bleibt der einzige Weg. Siehe README,
# Abschnitt "OIDC-Anmeldung einrichten", fuer Keycloak/Entra-Beispiele und
# welche Redirect-URI beim Provider zu hinterlegen ist.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Muss exakt der beim Provider hinterlegten Redirect-URI entsprechen (OAuth2
# vergleicht das beim Code-Austausch byte-genau).
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid email profile
# Optional: Claim-Name fuer die Team-Zugehoerigkeit (z. B. "groups"). Leer =
# team bleibt bei jedem OIDC-Login null, wie bei einem per CLI angelegten
# Nutzer ohne --team.
OIDC_TEAM_CLAIM=

# Cross-Origin-Uebergabe (README, Abschnitt "Cross-Origin-Uebergabe"): eine
# Oberflaeche auf einer ANDEREN Herkunft als dieses Gateway kann sich per
# `return_to` an GET /v1/auth/oidc/login einen einmal einloesbaren Code
# geben lassen (POST /v1/auth/session/exchange) statt sich auf das
# Session-Cookie zu verlassen, das ihre eigene Herkunft nie erreichen
# wuerde. JSON-Liste, Default leer = return_to wird IMMER ignoriert (Verhalten
# unveraendert). WARNUNG: nur Oberflaechen eintragen, denen genauso vertraut
# wird wie diesem Gateway selbst -- jeder Eintrag bekommt bei jedem Login
# einen frischen Sitzungscode zugestellt.
OIDC_POST_LOGIN_ALLOWED_URLS=[]
