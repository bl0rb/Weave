__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.env
# Any .env variant (.env.local, .env.bak-*, ...) carries real secrets; only
# the placeholder-filled example belongs in the repository.
.env.*
!.env.example
venv/
backend/.venv/
.venv/

# Downloaded model weights (e.g. reranker/.cache/'s BAAI/bge-reranker-v2-m3,
# ~2.3 GB) -- fetched fresh from the Hugging Face Hub on first load
# (app/services/model.py), never committed.
.cache/

.DS_Store

# Temporary build / test artefacts (session logs, scratch files)
*.log
*-build.txt
*-result.txt
